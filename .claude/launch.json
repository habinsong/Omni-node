{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "omninode-mw",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const http=require('http');http.createServer((req,res)=>{const p=new URL(req.url,'http://x').pathname;require('http').get('http://127.0.0.1:8080'+p,r=>{res.writeHead(r.statusCode||200,r.headers);r.pipe(res)}).on('error',()=>{res.writeHead(502);res.end()})}).listen(8090,()=>console.log('proxy listening on 8090'))"],
      "port": 8090
    }
  ]
}
